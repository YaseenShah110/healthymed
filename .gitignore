# Local Odoo config (contains credentials) - use odoo.conf.example as template
odoo.conf

# Local tooling env (real paths) - use .env.example as template
.env

# Real company data - use config/company.json.example as template
config/company.json

# Real payment terms - use config/payment_terms.json.example as template
config/payment_terms.json

# Real website/mail config - use the matching .example files as templates
config/website.json
config/mail.json

# Private/local-only data
data_private/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Odoo runtime
*.log
.filestore/
.sessions/

# Lint cache
.ruff_cache/

# CSV data, except module data/security fixtures
*.csv
!**/data/*.csv
!**/security/*.csv

# Editor/OS
.vscode/
.idea/
.DS_Store
Thumbs.db
