<?xml version="1.0" encoding="utf-8"?>
<!--
  Dedicated group, not a standard one - confirmed against the senior's system
  (staging has its own healthymed_ssb.group_ssb_prescription_officer, under its
  own category/privilege, same pattern as healthymed_rollen). See
  docs/decisions.md for why this overrides the original "do not create a new
  group" instruction.
-->
<odoo>
    <data>

        <record model="ir.module.category" id="module_category_healthymed_ssb">
            <field name="name">HealthyMed SSB</field>
        </record>

        <record model="res.groups.privilege" id="privilege_ssb_rezept_gate">
            <field name="name">SSB-Rezept-Gate</field>
            <field name="category_id" ref="module_category_healthymed_ssb"/>
        </record>

        <record id="group_ssb_prescription_officer" model="res.groups">
            <field name="name">Confirm SSB Prescription Receipt</field>
            <field name="privilege_id" ref="privilege_ssb_rezept_gate"/>
            <field name="comment">May confirm receipt of the checked, signed and stamped original prescription by mail, releasing delivery of SSB orders. An uploaded scan is optional and never releases delivery on its own.</field>
        </record>

        <record id="action_ssb_gate_recover_server" model="ir.actions.server">
            <field name="name">SSB: Recover after gate deactivation</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_view_types">list,form</field>
            <field name="group_ids" eval="[(4, ref('group_ssb_prescription_officer'))]"/>
            <field name="state">code</field>
            <field name="code">records.action_ssb_gate_recover()</field>
        </record>

    </data>
</odoo>
