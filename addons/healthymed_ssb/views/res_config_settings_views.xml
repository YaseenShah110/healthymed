<?xml version="1.0" encoding="utf-8"?>
<!-- Placement confirmed against the senior's system: Sales app settings, own block. -->
<odoo>
    <data>

        <record id="res_config_settings_view_form_ssb" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.healthymed.ssb</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//app[@name='sale_management']" position="inside">
                    <block title="Sprechstundenbedarf (SSB)" id="ssb_gate_setting_container">
                        <setting id="ssb_gate_setting" string="SSB-Rezept-Fulfillment-Gate"
                                 help="Block delivery validation for orders containing SSB items until the prescription is confirmed received.">
                            <field name="x_ssb_gate_enabled"/>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
