<?xml version="1.0" encoding="utf-8"?>
<!--
  Anchor verified in C:\odoo\odoo19\addons\product\views\product_views.xml:
  product.product_template_form_view, General Information page,
  group[@name='group_general'] (field "type" is the first field in it).
  "default_code" is NOT usable as an anchor here - it's only added inside
  product.product_template_only_form_view, a mode="primary" view, which does
  not feed into the extension chain other modules' views attach to (confirmed
  the hard way: Odoo refused to load this view with that anchor).
-->
<odoo>
    <data>

        <record id="product_template_form_view_ssb" model="ir.ui.view">
            <field name="name">product.template.form.healthymed.ssb</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='group_general']/field[@name='type']" position="after">
                    <field name="x_is_ssb"/>
                    <field name="x_pzn"/>
                </xpath>
            </field>
        </record>

        <record id="product_template_search_view_ssb" model="ir.ui.view">
            <field name="name">product.template.search.healthymed.ssb</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_search_view"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='filter_to_sell']" position="after">
                    <filter string="SSB" name="healthymed_ssb_filter" domain="[('x_is_ssb', '=', True)]"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
