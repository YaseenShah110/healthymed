<?xml version="1.0" encoding="utf-8"?>
<!--
  Anchors verified in C:\odoo\odoo19\addons\product\views\product_views.xml:
    - product.product_template_form_view: field "default_code" is added to the
      General Information page by product.product_template_only_form_view
      (priority 8, loads before this module), so it's present in the resolved
      arch by the time this view applies.
    - product.product_template_search_view: filter "filter_to_sell".
-->
<odoo>
    <data>

        <record id="product_template_form_view_ssb" model="ir.ui.view">
            <field name="name">product.template.form.healthymed.ssb</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='default_code']" position="after">
                    <field name="x_is_ssb"/>
                    <field name="x_pzn"/>
                </xpath>
            </field>
        </record>

        <record id="product_template_search_view_ssb" model="ir.ui.view">
            <field name="name">product.template.search.healthymed.ssb</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_search_view"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='filter_to_sell']" position="after">
                    <filter string="SSB" name="healthymed_ssb_filter" domain="[('x_is_ssb', '=', True)]"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
