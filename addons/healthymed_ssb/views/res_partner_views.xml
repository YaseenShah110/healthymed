<?xml version="1.0" encoding="utf-8"?>
<!--
  Anchor verified in C:\odoo\odoo19\odoo\addons\base\views\res_partner_views.xml:
  base.view_partner_form, page[@name='sales_purchases'], group[@name='misc'].
  Own new group, not a healthymed_base one (this module has no dependency on it).
-->
<odoo>
    <data>

        <record id="res_partner_view_form_ssb" model="ir.ui.view">
            <field name="name">res.partner.form.healthymed.ssb</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='misc']" position="after">
                    <group string="SSB" name="healthymed_ssb_group">
                        <field name="x_praxis_nr"/>
                        <field name="x_kv_nummer"/>
                    </group>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
