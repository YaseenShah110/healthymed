<?xml version="1.0" encoding="utf-8"?>
<!--
  Anchor verified in C:\odoo\odoo19\odoo\addons\base\views\res_company_views.xml:
  base.view_company_form, notebook > page[@name='general_info'].
-->
<odoo>
    <data>

        <record id="view_company_form_healthymed" model="ir.ui.view">
            <field name="name">res.company.form.healthymed.base</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='general_info']" position="after">
                    <page string="HealthyMed" name="healthymed">
                        <group>
                            <field name="x_regional_warehouse_id"/>
                            <field name="x_supplier_warehouse_id"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
